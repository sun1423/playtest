+
+// Android low-memory mode releases each completed stage's graph and metadata
+// arena immediately after its output has been copied to an owning std::vector.
+// The model weights remain resident. This lowers peak RAM at the cost of
+// rebuilding graph metadata on the next utterance.
+static bool s3gen_low_memory_enabled() {
+    const char * value = std::getenv("TTS_CPP_CHATTERBOX_LOW_MEMORY");
+    return value && value[0] && value[0] != '0';
+}
+
+static void s3gen_low_memory_release_encoder() {
+    if (!s3gen_low_memory_enabled()) return;
+    std::lock_guard<std::mutex> lk(g_synth_caches_mu);
+    g_encoder_graph_cache.destroy();
+    std::vector<uint8_t>().swap(g_encoder_graph_cache.buf);
+    g_pos_emb_results.clear();
+}
+
+static void s3gen_low_memory_release_cpu_mirrors() {
+    if (!s3gen_low_memory_enabled()) return;
+    std::lock_guard<std::mutex> lk(g_synth_caches_mu);
+    g_weight_cpu_mirror.clear();
+}
+
+static void s3gen_low_memory_release_cfm() {
+    if (!s3gen_low_memory_enabled()) return;
+    // This cache has its own mutex and must be released before taking the
+    // common S3Gen cache mutex (same order as s3gen_release_synth_caches()).
+    time_mlp_graph_cache_release();
+    std::lock_guard<std::mutex> lk(g_synth_caches_mu);
+    g_cfm_estimator_cache.destroy();
+    std::vector<uint8_t>().swap(g_cfm_estimator_cache.buf);
+    g_time_mlp_results.clear();
+    g_time_emb_results.clear();
+}
+
+static void s3gen_low_memory_release_f0() {
+    if (!s3gen_low_memory_enabled()) return;
+    std::lock_guard<std::mutex> lk(g_synth_caches_mu);
+    g_f0_graph_cache.destroy();
+    std::vector<uint8_t>().swap(g_f0_graph_cache.buf);
+}
+
+static void s3gen_low_memory_release_stft() {
+    if (!s3gen_low_memory_enabled()) return;
+    std::lock_guard<std::mutex> lk(g_synth_caches_mu);
+    g_stft_graph_cache.destroy();
+    std::vector<uint8_t>().swap(g_stft_graph_cache.buf);
+    g_stft_kernel_cache.clear();
+}
+
+static void s3gen_low_memory_release_hift() {
+    if (!s3gen_low_memory_enabled()) return;
+    std::lock_guard<std::mutex> lk(g_synth_caches_mu);
+    g_hift_graph_cache.destroy();
+    std::vector<uint8_t>().swap(g_hift_graph_cache.buf);
+    g_hift_inv_alpha_entries.clear();
+    g_inv_alpha_results.clear();
+    g_hann_window_cache.clear();
+    g_istft_kernel_cache.clear();
+    g_window_sum_cache.clear();
 }
 
